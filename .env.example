# ── Django ────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexusroute

# ── CORS (React frontend origins) ─────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Redis (route caching, added in Phase 3) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Road routing (OSRM) — optional, has sane defaults ─────────────
# Defaults to the public OSRM demo server (free, no key needed, but
# no uptime guarantee). Point at a self-hosted instance for production.
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_SECONDS=5
